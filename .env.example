# Optional: 80 (default) lets the phone open plain h.local with no :port.
PORT=
OPENAI_API_KEY=your_openai_api_key_here
# Optional: defaults to the model in shared/analysis-contract.json.
OPENAI_MODEL=
# Optional: low (default, fastest), medium, high; more effort = slower but more careful.
OPENAI_REASONING_EFFORT=
# Optional: default prompt when a client omits one.
ANALYZE_PROMPT=
