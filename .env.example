PORT=3000
OPENAI_API_KEY=your_openai_api_key_here
# Optional: defaults to the model in shared/analysis-contract.json.
OPENAI_MODEL=
# Optional: default prompt when a client omits one.
ANALYZE_PROMPT=
# Set a long password of your own so the viewer and share links stay the same.
# Blank = a new random token on every start (old links stop working).
VIEWER_TOKEN=
HISTORY_MAX_ITEMS=25
